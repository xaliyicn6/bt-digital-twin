# 复制为 .env 后填写；本文件不得写入真实口令或密钥
DATABASE_URL=postgresql://bt:bt@127.0.0.1:55432/bt
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
# MinIO 容器 root 凭据：仅本地开发，必须自行填写，禁止提交真实值
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 点云 Mock 目录（M04 准备阶段）：存放 <componentId>.copc.laz 占位文件
# 缺省为 backend/var/mock_pointcloud
POINTCLOUD_MOCK_DIR=
REDIS_URL=redis://127.0.0.1:6379/0
# JWT 私钥走文件挂载，不写在此处
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
INFER_ENDPOINT=http://127.0.0.1:8081
